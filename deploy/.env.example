# Public image. Use immutable release tag or digest for client deployments.
# Example digest: ghcr.io/jusso-dev/kelpie@sha256:<published-digest>
KELPIE_IMAGE_REF=ghcr.io/jusso-dev/kelpie:latest

# Bind locally until reverse proxy/TLS is configured. Do not expose this directly
# to the internet; set APP_URL and BETTER_AUTH_URL to final HTTPS origin first.
KELPIE_BIND_ADDRESS=127.0.0.1
KELPIE_PORT=3000
# LAN address where the bundled HTTPS proxy listens. Must exist on the host.
KELPIE_HTTPS_BIND_ADDRESS=192.168.1.10

# PostgreSQL. Generate a unique password, do not reuse application secrets.
POSTGRES_USER=kelpie
POSTGRES_PASSWORD=replace_with_a_unique_long_database_password
POSTGRES_DB=kelpie
REDIS_URL=redis://redis:6379
JOBS_CONCURRENCY=5

# Required application secrets. Generate each with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace_with_a_unique_long_auth_secret
CRON_SECRET=replace_with_a_unique_long_cron_secret

# Final external origin. Must be HTTPS for production client deployments.
BETTER_AUTH_URL=https://kelpie.example.com
# Optional comma-separated origins that may call Better Auth in addition to
# BETTER_AUTH_URL. Include scheme and port; use exact origins where possible.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
# Passkeys require HTTPS outside localhost. RP ID is hostname only; origin is
# exact public URL used in browser. The bundled Caddy proxy uses PASSKEY_ORIGIN
# as its site address.
PASSKEY_RP_ID=kelpie.example.com
PASSKEY_ORIGIN=https://kelpie.example.com
APP_URL=https://kelpie.example.com
EMAIL_PROVIDER=console
EMAIL_FROM=kelpie@example.com

# Optional services
RESEND_API_KEY=
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AZURE_COMMUNICATION_EMAIL_CONNECTION_STRING=
AZURE_COMMUNICATION_EMAIL_SENDER=
VIRUSTOTAL_API_KEY=
CLOUDFLARE_RADAR_API_TOKEN=
KELPIE_ALLOW_PRIVATE_NETWORKS=false
S3_BUCKET=
S3_REGION=ap-southeast-2
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=dev.kelpie.mobile
