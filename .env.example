# Database
DATABASE_URL=postgres://kelpie:kelpie@localhost:5432/kelpie
POSTGRES_USER=kelpie
# Development value only. Replace this and DATABASE_URL together before deployment.
POSTGRES_PASSWORD=kelpie
POSTGRES_DB=kelpie
REDIS_URL=redis://localhost:6379
JOBS_CONCURRENCY=5

# AES-256-GCM key for mailbox (and future) credentials at rest.
# 32 bytes as 64 hex chars, or standard/base64url encoding of 32 bytes.
# Required to create or poll mailbox connections.
CREDENTIALS_ENCRYPTION_KEY=

# Container deployment
KELPIE_IMAGE=ghcr.io/jusso-dev/kelpie:latest
KELPIE_BIND_ADDRESS=127.0.0.1

# BetterAuth
BETTER_AUTH_SECRET=replace_me_with_a_long_random_secret
BETTER_AUTH_URL=http://localhost:3000

# App
APP_URL=http://localhost:3000
NODE_ENV=development

# Email (optional, falls back to console). Choose: console, resend, ses, azure.
EMAIL_PROVIDER=console
EMAIL_FROM=kelpie@example.com
RESEND_API_KEY=
# SES uses the standard AWS credential chain plus this region.
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Azure Communication Services Email. The sender must be verified by Azure.
AZURE_COMMUNICATION_EMAIL_CONNECTION_STRING=
AZURE_COMMUNICATION_EMAIL_SENDER=

# Shared secret for the legacy/manual /api/cron/* endpoints.
CRON_SECRET=replace_me_with_a_long_random_cron_secret

# Single sign-on (SAML / OIDC) and SOAR action callback URLs are built from
# APP_URL (above). Set APP_URL to your public origin so IdP redirect/ACS URLs
# and the per-org SSO endpoints resolve correctly. SSO providers, SIEM
# connectors, TI feeds, and response actions are all configured per
# organisation from the UI; no extra env is required for them.

# Optional: org-level VirusTotal key can be set under Settings; this env is
# used as a fallback for single-tenant installs.
VIRUSTOTAL_API_KEY=
# Cloudflare Radar token with Account Radar Read permission for Threat landscape.
CLOUDFLARE_RADAR_API_TOKEN=
# Optional logo.dev token. Iconify and favicon fallbacks work without one.
KELPIE_LOGO_DEV_TOKEN=

# File storage. Local disk by default. Set S3 vars to use S3 or MinIO.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads

# ClamAV clamd host/port for evidence malware scanning. Unset by default: with
# no scanner configured, uploads are held as scan_failed (never silently
# marked available) until an admin records a reasoned quarantine override.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Set only when Kelpie must call intentionally private, self-hosted integrations.
KELPIE_ALLOW_PRIVATE_NETWORKS=false
S3_BUCKET=
S3_REGION=ap-southeast-2
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional Apple Push Notification service provider credentials for the iOS
# companion. APNS_PRIVATE_KEY is the contents of the .p8 key; escaped newlines
# are accepted. Leave unset to retain routed notifications in the pending
# outbox until APNs is configured.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=dev.kelpie.mobile
